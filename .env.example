HOST=127.0.0.1
PORT=3000
BOM_MODE=demo
# Set a strong shared access token if binding beyond loopback. Use SSO proxy for deployment.
# BOM_APP_TOKEN=
# Gateway mode pulls normalized, authorized snapshots automatically on each comparison.
# BOM_MODE=gateway
# BOM_GATEWAY_URL=https://your-internal-bom-gateway.example/api
# BOM_GATEWAY_TOKEN=
# Alternative for a service-populated directory, never commit internal snapshots:
# BOM_MODE=directory
# BOM_DATA_DIR=/absolute/path/to/normalized-snapshots
